# Lynewed - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# SUPABASE (required)
# ============================================
# Get from: Dashboard Supabase > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# GOOGLE PLACES (required)
# ============================================
# Get from: Google Cloud Console > APIs & Services > Credentials
# Important: Restrict keys to your bundle ID (iOS) and package name (Android)
GOOGLE_PLACES_API_KEY_IOS=your-ios-api-key
GOOGLE_PLACES_API_KEY_ANDROID=your-android-api-key

# ============================================
# AGORA VIDEO CALLS (required)
# ============================================
# Get from: Console Agora.io > Project Management
AGORA_APP_ID=your-agora-app-id

# ============================================
# FIREBASE (configured separately)
# ============================================
# Firebase is configured via:
# - iOS: ios/Runner/GoogleService-Info.plist
# - Android: android/app/google-services.json
# No .env variables needed for Firebase
