# =================================================================
# LYNEWED - Variables d'Environnement (EXEMPLE)
# =================================================================
# ⚠️ NE PAS COMMITER DE VRAIES CLÉS DANS CE FICHIER
# Copier ce fichier en .env et remplacer par vos vraies valeurs
# =================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Firebase Configuration (iOS)
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key_here
FIREBASE_IOS_APP_ID=your_firebase_ios_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_IOS_BUNDLE_ID=com.your.app

# Firebase Configuration (Android)
FIREBASE_ANDROID_APP_ID=your_firebase_android_app_id_here

# Google Places API (À protéger - Facturable !)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Agora Video (À protéger - Facturable !)
AGORA_APP_ID=your_agora_app_id_here
